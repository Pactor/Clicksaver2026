<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- 32-bit so the app can hand its own LoadLibraryW address to the 32-bit client. -->
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>ClickSaver2026</AssemblyName>
    <RootNamespace>ClickSaver2026.App</RootNamespace>
    <!-- The exe/taskbar/title-bar icon (generated from clicksaver2026.png at the repo root). -->
    <ApplicationIcon>..\clicksaver2026.ico</ApplicationIcon>
    <!-- ThemeMode (Fluent) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>

    <!-- The runnable app: Build\Release\ClickSaver2026.exe. CMake puts the hook DLL beside it. -->
    <OutDir>$(BuildRoot)$(Configuration)\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClickSaver2026.Core\ClickSaver2026.Core.csproj" />
  </ItemGroup>

  <Target Name="ReportMissingHook" AfterTargets="Build" Condition="!Exists('$(OutDir)ClickSaver2026.Hook.dll')">
    <Message Importance="high" Text="ClickSaver2026.Hook.dll is not in $(OutDir) yet - run build.ps1 to build the hook." />
  </Target>

</Project>
