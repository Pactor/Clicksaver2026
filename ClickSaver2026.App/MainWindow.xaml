<Window x:Class="ClickSaver2026.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:ClickSaver2026.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance app:MainViewModel}"
        Title="ClickSaver2026" Width="1000" Height="820" MinWidth="640" MinHeight="480">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Hook.Status}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="8">
            <TabItem Header="Missions" DataContext="{Binding Missions}">
                <DockPanel Margin="8">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="AO folder:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding ClientFolder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="Detect" Command="{Binding DetectCommand}" Margin="8,0,0,0" Visibility="{Binding SetupVisibility}" />
                        <Button Grid.Column="3" Content="Set folder..." Command="{Binding BrowseCommand}" Margin="8,0,0,0" Visibility="{Binding SetupVisibility}" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding DatabaseStatus}" Margin="0,4,0,0" Opacity="0.75" />
                    </Grid>

                    <GroupBox Header="Buying agent" DockPanel.Dock="Top" Margin="0,0,0,8"
                              DataContext="{Binding DataContext.BuyingAgent, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Watch items:" VerticalAlignment="Top" Margin="0,4,8,0" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ItemWatch, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                     Height="60" VerticalContentAlignment="Top"
                                     ToolTip="One item name per line; a mission matches if any line matches (substring, so partial or exact). Within a line: space-separated terms all match, -term excludes, &quot;quoted phrase&quot;." />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Watch areas:" VerticalAlignment="Top" Margin="0,8,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LocationWatch, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                     Height="44" VerticalContentAlignment="Top" Margin="0,4,0,0"
                                     ToolTip="Optional. One playfield per line (substring), e.g. Borealis. A mission matches only if it is in a watched area AND (if set) matches a watched item." />
                            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="12,4,0,0" MinWidth="150">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Max rolls:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding MaxRolls}" Width="52" />
                                </StackPanel>
                                <TextBlock Text="Difficulty:" Margin="0,0,0,2" />
                                <ComboBox SelectedIndex="{Binding Difficulty}" Margin="0,0,0,8"
                                          ToolTip="Roll at this slider tick every time. 'Repeat last roll' uses the difficulty of your last hand-roll. Higher tick = higher mission level (its QL depends on your level).">
                                    <ComboBoxItem>Repeat last roll</ComboBoxItem>
                                    <ComboBoxItem>Tick 1 (easiest)</ComboBoxItem>
                                    <ComboBoxItem>Tick 2</ComboBoxItem>
                                    <ComboBoxItem>Tick 3</ComboBoxItem>
                                    <ComboBoxItem>Tick 4</ComboBoxItem>
                                    <ComboBoxItem>Tick 5</ComboBoxItem>
                                    <ComboBoxItem>Tick 6</ComboBoxItem>
                                    <ComboBoxItem>Tick 7</ComboBoxItem>
                                    <ComboBoxItem>Tick 8</ComboBoxItem>
                                    <ComboBoxItem>Tick 9</ComboBoxItem>
                                    <ComboBoxItem>Tick 10</ComboBoxItem>
                                    <ComboBoxItem>Tick 11 (hardest)</ComboBoxItem>
                                </ComboBox>
                                <Button Content="Start" Command="{Binding StartCommand}" Margin="0,0,0,4" MinWidth="70" />
                                <Button Content="Stop" Command="{Binding StopCommand}" MinWidth="70" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                <CheckBox Content="Custom sliders" IsChecked="{Binding CustomSliders}" Margin="0,0,0,4"
                                          ToolTip="Set the six mission sliders on every roll (like the client's advanced panel). 0% = left pole, 100% = right pole, 50% = default." />
                                <WrapPanel IsEnabled="{Binding CustomSliders}">
                                    <StackPanel Margin="0,0,12,4">
                                        <TextBlock Text="Good–Bad" FontSize="11" Opacity="0.8" />
                                        <ComboBox Width="66" ItemsSource="{Binding SliderStepLabels}" SelectedIndex="{Binding GoodBad}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,4">
                                        <TextBlock Text="Order–Chaos" FontSize="11" Opacity="0.8" />
                                        <ComboBox Width="66" ItemsSource="{Binding SliderStepLabels}" SelectedIndex="{Binding OrderChaos}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,4">
                                        <TextBlock Text="Open–Hidden" FontSize="11" Opacity="0.8" />
                                        <ComboBox Width="66" ItemsSource="{Binding SliderStepLabels}" SelectedIndex="{Binding OpenHidden}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,4">
                                        <TextBlock Text="Physical–Mystical" FontSize="11" Opacity="0.8" />
                                        <ComboBox Width="66" ItemsSource="{Binding SliderStepLabels}" SelectedIndex="{Binding PhysicalMystical}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,4">
                                        <TextBlock Text="Head-on–Stealth" FontSize="11" Opacity="0.8" />
                                        <ComboBox Width="66" ItemsSource="{Binding SliderStepLabels}" SelectedIndex="{Binding HeadStealth}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,4">
                                        <TextBlock Text="Money–XP" FontSize="11" Opacity="0.8" />
                                        <ComboBox Width="66" ItemsSource="{Binding SliderStepLabels}" SelectedIndex="{Binding MoneyXp}" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding Status}" Margin="0,6,0,0" Opacity="0.85" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </GroupBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox Margin="0,0,8,0"
                                 ItemsSource="{Binding DataContext.Hook.Clients, RelativeSource={RelativeSource AncestorType=Window}}"
                                 SelectedItem="{Binding DataContext.Hook.SelectedClient, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RollSummary}" Opacity="0.75" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Column="1" Margin="16" Opacity="0.75" TextWrapping="Wrap"
                                   Text="No roll yet. Open a mission terminal in the game and request missions; the latest roll shows here."
                                   Visibility="{Binding DataContext.Hook.SelectedClient.CurrentRoll, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static app:NotNullToCollapsed.Instance}}" />

                        <DockPanel Grid.Column="1" DataContext="{Binding DataContext.Hook.SelectedClient.CurrentRoll, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Header}" Margin="0,0,0,8" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Missions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                    ToolTip="{Binding Description}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Money}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Location}" Opacity="0.8" Margin="0,2,0,6" />
                                                    <ItemsControl ItemsSource="{Binding Rewards}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <DockPanel Margin="0,4,0,0">
                                                                    <Border DockPanel.Dock="Left" Width="52" Height="52" Margin="0,0,10,0" CornerRadius="4"
                                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                                        <Image Source="{Binding Icon}" Width="48" Height="48" Stretch="Uniform"
                                                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                                    </Border>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding Details}" Opacity="0.8" />
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding FindItem}" Margin="0,6,0,0" Opacity="0.8"
                                                               Visibility="{Binding FindItem, Converter={x:Static app:NullToCollapsed.Instance}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Hook" DataContext="{Binding Hook}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Header="Game clients" Grid.Row="0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="130">
                                <Button Content="Attach" Command="{Binding AttachCommand}" Margin="0,0,0,4" />
                                <Button Content="Detach" Command="{Binding DetachCommand}" Margin="0,0,0,4" />
                                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,0,8" />
                                <Button Content="Detach all" Command="{Binding DetachAllCommand}" Margin="0,0,0,4" />
                                <Button Content="Re-attach all" Command="{Binding ReattachAllCommand}" Margin="0,0,0,8"
                                        ToolTip="Detach then re-attach every client, to reset the hook without closing the app." />
                                <CheckBox Content="Attach automatically" IsChecked="{Binding AutoAttach}" />
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      SelectionMode="Single" Height="120">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessId}" />
                                    <DataGridTextColumn Header="Window" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="Hook" Binding="{Binding State}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Header="Capture" Grid.Row="1" Margin="0,8,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Open folder" Command="{Binding OpenCaptureFolderCommand}" Margin="8,0,0,0" />
                                <CheckBox Content="Save messages to a capture file" IsChecked="{Binding CaptureEnabled}" VerticalAlignment="Center" />
                            </DockPanel>
                            <CheckBox Content="Only messages matching the ClickSaver 2.x mission signature" IsChecked="{Binding CaptureLegacyOnly}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding CaptureFile}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </GroupBox>

                    <DockPanel Grid.Row="2" Margin="0,8,0,4">
                        <Button DockPanel.Dock="Right" Content="Clear list" Command="{Binding ClearCommand}" />
                        <TextBlock Text="{Binding Counters}" VerticalAlignment="Center" />
                    </DockPanel>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              SelectionMode="Single" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" />
                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessId}" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" />
                            <DataGridTextColumn Header="Bytes" Binding="{Binding Size}" />
                            <DataGridCheckBoxColumn Header="Legacy mission" Binding="{Binding LegacyMatch, Mode=OneWay}" />
                            <DataGridTextColumn Header="First bytes" Binding="{Binding Preview}" Width="*"
                                                FontFamily="{StaticResource MonoFont}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" />

                    <TextBox Grid.Row="5" Text="{Binding SelectedMessageDump, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
